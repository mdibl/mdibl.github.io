// codespaces.config
// Settings about the COMPUTER the pipeline runs on (not about your data).
// A 4-core GitHub Codespace has 4 CPUs and 16 GB of memory, so no single
// step is allowed to ask for more than this.

process {
    resourceLimits = [
        cpus:   4,
        memory: '12.GB',
        time:   '2.h'
    ]
}
